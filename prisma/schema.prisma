// ============================================================================
// Prisma schema — Personal Brand + Digital Marketplace + Academy platform
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// AUTH / IDENTITY / RBAC
// ─────────────────────────────────────────────────────────────────────────

enum RoleName {
  SUPER_ADMIN
  ADMIN
  MANAGER
  SHOP_MANAGER
  ACADEMY_MANAGER
  ACCOUNTANT
  SUPPORT
  EDITOR
  CUSTOMER
}

model Role {
  id          String           @id @default(cuid())
  name        RoleName         @unique
  label       String
  description String?
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique // e.g. "shop.products.write"
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String?   @unique
  emailVerifiedAt  DateTime?
  phone            String?   @unique
  phoneVerifiedAt  DateTime?
  passwordHash     String?
  avatarUrl        String?
  nationalCode     String?
  roleId           String
  role             Role      @relation(fields: [roleId], references: [id])
  isActive         Boolean   @default(true)
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions        Session[]
  otpCodes        OtpCode[]
  loginHistory    LoginHistory[]
  auditLogs       AuditLog[]
  orders          Order[]
  reviews         Review[]
  questions       Question[]
  wishlist        WishlistItem[]
  downloads       Download[]
  enrollments     Enrollment[]
  progress        LessonProgress[]
  courseReviews   CourseReview[]
  projectRequests ProjectRequest[]
  notifications   Notification[]
  tickets         Ticket[]
  ticketMessages  TicketMessage[]
  addresses       Address[]
  invoices        Invoice[]
  cart            Cart?

  @@index([roleId])
}

model Session {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  ipAddress   String?
  userAgent   String?
  deviceLabel String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

enum OtpPurpose {
  LOGIN
  REGISTER
  RESET_PASSWORD
  VERIFY_PHONE
  VERIFY_EMAIL
}

model OtpCode {
  id          String     @id @default(cuid())
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination String // phone or email
  purpose     OtpPurpose
  codeHash    String
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())

  @@index([destination, purpose])
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  success   Boolean
  ipAddress String?
  userAgent String?
  reason    String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String
  province   String?
  city       String?
  postalCode String?
  line1      String
  line2      String?
  phone      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────
// PERSONAL BRAND (CMS-driven)
// ─────────────────────────────────────────────────────────────────────────

model Profile {
  id              String   @id @default(cuid())
  fullName        String
  headline        String
  bio             String   @db.Text
  avatarUrl       String?
  resumeFileUrl   String?
  email           String?
  phone           String?
  location        String?
  availability    String? // e.g. "Available for freelance"
  yearsExperience Int?
  socialLinks     Json? // { github, linkedin, twitter, instagram, telegram }
  updatedAt       DateTime @updatedAt
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

model Skill {
  id        String     @id @default(cuid())
  name      String
  category  String?
  level     SkillLevel @default(INTERMEDIATE)
  iconUrl   String?
  order     Int        @default(0)
  createdAt DateTime   @default(now())
}

model Experience {
  id          String    @id @default(cuid())
  role        String
  company     String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean   @default(false)
  description String    @db.Text
  order       Int       @default(0)
}

model EducationItem {
  id           String    @id @default(cuid())
  degree       String
  institution  String
  fieldOfStudy String?
  startDate    DateTime
  endDate      DateTime?
  isCurrent    Boolean   @default(false)
  description  String?   @db.Text
  order        Int       @default(0)
}

model Certificate {
  id            String    @id @default(cuid())
  title         String
  issuer        String
  issueDate     DateTime
  expiryDate    DateTime?
  credentialUrl String?
  imageUrl      String?
  order         Int       @default(0)
}

model Service {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String   @db.Text
  iconUrl     String?
  priceFrom   Decimal? @db.Decimal(12, 0)
  domain      String? // Web, WordPress, FiveM, VMP, MTA
  order       Int      @default(0)
  isActive    Boolean  @default(true)
}

model PortfolioProject {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  description  String   @db.Text
  category     String?
  technologies String[]
  images       String[]
  liveUrl      String?
  repoUrl      String?
  features     String[]
  isFeatured   Boolean  @default(false)
  date         DateTime @default(now())
  order        Int      @default(0)
  createdAt    DateTime @default(now())
}

model Testimonial {
  id         String   @id @default(cuid())
  authorName String
  authorRole String?
  avatarUrl  String?
  content    String   @db.Text
  rating     Int      @default(5)
  isFeatured Boolean  @default(false)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────
// SHOP — Products, Cart, Orders, Downloads, Reviews
// ─────────────────────────────────────────────────────────────────────────

enum ProductDomain {
  WEB
  WORDPRESS
  FIVEM
  VMP
  MTA
  GENERAL
}

model Category {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  domain      ProductDomain @default(GENERAL)
  parentId    String?
  parent      Category?     @relation("CategoryTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    Category[]    @relation("CategoryTree")
  order       Int           @default(0)
  products    Product[]
  courses     Course[]
  createdAt   DateTime      @default(now())
}

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  slug     String       @unique
  products ProductTag[]
}

enum ProductType {
  FREE_PRODUCT
  PREMIUM_PRODUCT
  SERVICE
}

model Product {
  id                 String        @id @default(cuid())
  title              String
  slug               String        @unique
  description        String        @db.Text
  shortDescription   String?
  categoryId         String
  category           Category      @relation(fields: [categoryId], references: [id])
  domain             ProductDomain @default(GENERAL)
  productType        ProductType   @default(FREE_PRODUCT)
  isFree             Boolean       @default(true)
  price              Decimal       @default(0) @db.Decimal(12, 0)
  salePrice          Decimal?      @db.Decimal(12, 0)
  currency           String        @default("IRT")
  coverImage         String?
  gallery            String[]
  version            String?
  changelog          String?       @db.Text
  license            String?
  downloadLimit      Int? // null = unlimited
  downloadExpiryDays Int? // null = never expires
  requirements       String?       @db.Text
  compatibility      String?
  documentationUrl   String?
  isPublished        Boolean       @default(false)
  isFeatured         Boolean       @default(false)
  viewCount          Int           @default(0)
  salesCount         Int           @default(0)
  avgRating          Float         @default(0)
  reviewCount        Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  tags         ProductTag[]
  files        ProductFile[]
  versions     ProductVersion[]
  orderItems   OrderItem[]
  reviews      Review[]
  questions    Question[]
  wishlistedBy WishlistItem[]
  downloads    Download[]

  @@index([categoryId])
  @@index([domain, productType])
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

// Files are stored outside the public web root; served only via signed URLs.
model ProductFile {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  fileName   String
  storageKey String // path within private storage
  mimeType   String
  sizeBytes  BigInt
  checksum   String?
  createdAt  DateTime @default(now())
}

model ProductVersion {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  version    String
  changelog  String?  @db.Text
  storageKey String?
  createdAt  DateTime @default(now())
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  PROCESSING
  COMPLETED
  CANCELLED
  REFUNDED
  FAILED
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
  createdAt DateTime   @default(now())
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([cartId, productId])
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  description    String?
  discountType   String // "PERCENT" | "FIXED"
  discountValue  Decimal   @db.Decimal(12, 0)
  maxRedemptions Int?
  redeemedCount  Int       @default(0)
  minOrderTotal  Decimal?  @db.Decimal(12, 0)
  startsAt       DateTime?
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  orders         Order[]
  createdAt      DateTime  @default(now())
}

model GiftCard {
  id           String    @id @default(cuid())
  code         String    @unique
  initialValue Decimal   @db.Decimal(12, 0)
  balance      Decimal   @db.Decimal(12, 0)
  isActive     Boolean   @default(true)
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  status        OrderStatus @default(PENDING)
  subtotal      Decimal     @db.Decimal(12, 0)
  discountTotal Decimal     @default(0) @db.Decimal(12, 0)
  total         Decimal     @db.Decimal(12, 0)
  currency      String      @default("IRT")
  couponId      String?
  coupon        Coupon?     @relation(fields: [couponId], references: [id])
  items         OrderItem[]
  payments      Payment[]
  invoice       Invoice?
  refunds       Refund[]
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  title     String // snapshot at purchase time
  unitPrice Decimal @db.Decimal(12, 0)
  quantity  Int     @default(1)
  total     Decimal @db.Decimal(12, 0)

  @@index([orderId])
  @@index([productId])
}

enum PaymentProvider {
  ZARINPAL
  IDPAY
  NEXTPAY
  CUSTOM_GATEWAY
  WALLET
}

enum PaymentStatus {
  INITIATED
  PENDING_VERIFICATION
  VERIFIED
  FAILED
  CANCELLED
}

model Payment {
  id              String          @id @default(cuid())
  orderId         String
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider        PaymentProvider
  status          PaymentStatus   @default(INITIATED)
  amount          Decimal         @db.Decimal(12, 0)
  currency        String          @default("IRT")
  authority       String? // gateway transaction/authority token
  refId           String? // gateway reference id after verification
  rawResponse     Json?
  webhookVerified Boolean         @default(false)
  createdAt       DateTime        @default(now())
  verifiedAt      DateTime?

  @@index([orderId])
  @@index([authority])
}

model Refund {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(12, 0)
  reason    String?
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED | PAID
  createdAt DateTime @default(now())
}

// License key issued to a customer for a purchased product
model License {
  id          String    @id @default(cuid())
  key         String    @unique
  productId   String
  userId      String
  orderId     String?
  isActive    Boolean   @default(true)
  activatedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
}

// Grants a user permission to download a specific product; created only
// after payment verification (or immediately for free products).
model Download {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItemId   String?
  downloadCount Int       @default(0)
  downloadLimit Int?
  expiresAt     DateTime?
  lastToken     String? // last issued signed-token jti, for auditing
  createdAt     DateTime  @default(now())

  @@unique([userId, productId])
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Int
  title      String?
  content    String?  @db.Text
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([productId])
}

model Question {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   String    @db.Text
  answer     String?   @db.Text
  answeredAt DateTime?
  isPublic   Boolean   @default(true)
  createdAt  DateTime  @default(now())

  @@index([productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ─────────────────────────────────────────────────────────────────────────
// ACADEMY — Courses / Lessons / Enrollment / Progress
// ─────────────────────────────────────────────────────────────────────────

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model Course {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  description     String        @db.Text
  coverImage      String?
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id])
  domain          ProductDomain @default(GENERAL)
  level           CourseLevel   @default(BEGINNER)
  durationMinutes Int?
  requirements    String?       @db.Text
  isFree          Boolean       @default(true)
  price           Decimal       @default(0) @db.Decimal(12, 0)
  salePrice       Decimal?      @db.Decimal(12, 0)
  isPublished     Boolean       @default(false)
  isFeatured      Boolean       @default(false)
  avgRating       Float         @default(0)
  reviewCount     Int           @default(0)
  studentCount    Int           @default(0)
  sourceCodeUrl   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  sections    CourseSection[]
  enrollments Enrollment[]
  reviews     CourseReview[]
  questions   CourseQuestion[]

  @@index([categoryId])
}

model CourseSection {
  id       String   @id @default(cuid())
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  order    Int      @default(0)
  lessons  Lesson[]
}

enum LessonType {
  VIDEO
  ARTICLE
  QUIZ
  ATTACHMENT
}

model Lesson {
  id              String             @id @default(cuid())
  sectionId       String
  section         CourseSection      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title           String
  type            LessonType         @default(VIDEO)
  contentUrl      String? // signed/private video storage key or article path
  contentBody     String?            @db.Text
  durationSeconds Int?
  isPreview       Boolean            @default(false) // free preview without enrollment
  order           Int                @default(0)
  attachments     LessonAttachment[]
  quiz            Quiz?
  progress        LessonProgress[]
  createdAt       DateTime           @default(now())
}

model LessonAttachment {
  id         String @id @default(cuid())
  lessonId   String
  lesson     Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  fileName   String
  storageKey String
  sizeBytes  BigInt
}

model Quiz {
  id        String         @id @default(cuid())
  lessonId  String         @unique
  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
}

model QuizQuestion {
  id           String   @id @default(cuid())
  quizId       String
  quiz         Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  prompt       String   @db.Text
  choices      String[]
  correctIndex Int
  order        Int      @default(0)
}

enum EnrollmentSource {
  PURCHASE
  FREE
  ADMIN_GRANT
}

model Enrollment {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId     String
  course       Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  source       EnrollmentSource @default(PURCHASE)
  orderItemId  String?
  progressPct  Float            @default(0)
  lastLessonId String?
  completedAt  DateTime?
  certificate  Certificate2?
  createdAt    DateTime         @default(now())

  @@unique([userId, courseId])
  @@index([courseId])
}

model LessonProgress {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId       String
  lesson         Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  isCompleted    Boolean   @default(false)
  watchedSeconds Int       @default(0)
  completedAt    DateTime?
  updatedAt      DateTime  @updatedAt

  @@unique([userId, lessonId])
}

// Named Certificate2 to avoid clashing with the personal-brand Certificate model.
model Certificate2 {
  id           String     @id @default(cuid())
  enrollmentId String     @unique
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  serialNumber String     @unique
  issuedAt     DateTime   @default(now())
  fileUrl      String?
}

model CourseReview {
  id         String   @id @default(cuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Int
  content    String?  @db.Text
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model CourseQuestion {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId    String
  question  String   @db.Text
  answer    String?  @db.Text
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────
// CONTENT — Articles / Tutorials / Roadmaps / Resources / Pages / FAQ
// ─────────────────────────────────────────────────────────────────────────

enum ContentType {
  ARTICLE
  TUTORIAL
  ROADMAP
  RESOURCE
}

model Article {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  type           ContentType   @default(ARTICLE)
  excerpt        String?
  body           String        @db.Text
  coverImage     String?
  domain         ProductDomain @default(GENERAL)
  authorName     String?
  isPublished    Boolean       @default(false)
  publishedAt    DateTime?
  viewCount      Int           @default(0)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Page {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique // e.g. "terms", "privacy", "refund-policy"
  body           String   @db.Text
  isPublished    Boolean  @default(true)
  seoTitle       String?
  seoDescription String?
  updatedAt      DateTime @updatedAt
}

model FaqItem {
  id       String  @id @default(cuid())
  question String
  answer   String  @db.Text
  group    String?
  order    Int     @default(0)
}

model Banner {
  id        String    @id @default(cuid())
  title     String
  imageUrl  String
  linkUrl   String?
  placement String // "home_hero", "shop_top", etc.
  isActive  Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  order     Int       @default(0)
}

model NavigationItem {
  id       String           @id @default(cuid())
  label    String
  url      String
  location String // "header" | "footer"
  parentId String?
  parent   NavigationItem?  @relation("NavTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children NavigationItem[] @relation("NavTree")
  order    Int              @default(0)
}

// ─────────────────────────────────────────────────────────────────────────
// CUSTOM DEVELOPMENT / PROJECT MANAGEMENT
// ─────────────────────────────────────────────────────────────────────────

enum ProjectType {
  WEBSITE
  WORDPRESS
  FIVEM
  VMP
  MTA
  PLUGIN
  SCRIPT
  UI_UX
  OTHER
}

enum BudgetRange {
  UNDER_10M
  R10M_30M
  R30M_70M
  OVER_70M
  NOT_DECIDED
}

enum ProjectStatus {
  NEW
  REVIEWING
  QUOTED
  ACCEPTED
  IN_PROGRESS
  WAITING_FOR_CLIENT
  COMPLETED
  DELIVERED
  CANCELLED
}

enum ProjectPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model ProjectRequest {
  id             String           @id @default(cuid())
  userId         String?
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  contactName    String
  contactEmail   String
  contactPhone   String?
  projectType    ProjectType
  categoryDomain ProductDomain?
  description    String           @db.Text
  requirements   String?          @db.Text
  budgetRange    BudgetRange      @default(NOT_DECIDED)
  deadline       DateTime?
  priority       ProjectPriority  @default(NORMAL)
  status         ProjectStatus    @default(NEW)
  attachments    String[]
  quotedPrice    Decimal?         @db.Decimal(12, 0)
  milestones     Milestone[]
  tasks          ProjectTask[]
  messages       ProjectMessage[]
  invoices       Invoice[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
}

model Milestone {
  id          String         @id @default(cuid())
  projectId   String
  project     ProjectRequest @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  dueDate     DateTime?
  isCompleted Boolean        @default(false)
  order       Int            @default(0)
}

model ProjectTask {
  id          String         @id @default(cuid())
  projectId   String
  project     ProjectRequest @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  isCompleted Boolean        @default(false)
  order       Int            @default(0)
}

model ProjectMessage {
  id          String         @id @default(cuid())
  projectId   String
  project     ProjectRequest @relation(fields: [projectId], references: [id], onDelete: Cascade)
  senderName  String
  isFromAdmin Boolean        @default(false)
  message     String         @db.Text
  attachments String[]
  createdAt   DateTime       @default(now())
}

// ─────────────────────────────────────────────────────────────────────────
// ACCOUNTING — Invoices, Transactions
// ─────────────────────────────────────────────────────────────────────────

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id            String          @id @default(cuid())
  invoiceNumber String          @unique
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  orderId       String?         @unique
  order         Order?          @relation(fields: [orderId], references: [id])
  projectId     String?
  project       ProjectRequest? @relation(fields: [projectId], references: [id])
  amount        Decimal         @db.Decimal(12, 0)
  status        InvoiceStatus   @default(DRAFT)
  dueDate       DateTime?
  paidAt        DateTime?
  createdAt     DateTime        @default(now())
}

enum TransactionType {
  INCOME
  EXPENSE
}

model Transaction {
  id            String          @id @default(cuid())
  type          TransactionType
  category      String // "product_sale" | "course_sale" | "project_revenue" | "refund" | "operating_expense" ...
  amount        Decimal         @db.Decimal(12, 0)
  description   String?
  referenceType String? // "Order" | "Invoice" | "Refund"
  referenceId   String?
  occurredAt    DateTime        @default(now())
  createdAt     DateTime        @default(now())

  @@index([type, category])
  @@index([occurredAt])
}

// ─────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS / SMS / EMAIL LOGS
// ─────────────────────────────────────────────────────────────────────────

enum NotificationChannel {
  IN_APP
  SMS
  EMAIL
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   NotificationChannel @default(IN_APP)
  title     String
  body      String
  isRead    Boolean             @default(false)
  link      String?
  createdAt DateTime            @default(now())

  @@index([userId, isRead])
}

enum SmsStatus {
  QUEUED
  SENT
  FAILED
  DELIVERED
}

model SmsTemplate {
  id   String @id @default(cuid())
  key  String @unique // "otp", "order_confirmed", ...
  body String @db.Text
}

model SmsLog {
  id          String    @id @default(cuid())
  toPhone     String
  templateKey String?
  body        String
  provider    String
  status      SmsStatus @default(QUEUED)
  providerRef String?
  error       String?
  createdAt   DateTime  @default(now())

  @@index([toPhone])
}

model EmailLog {
  id          String   @id @default(cuid())
  toEmail     String
  templateKey String?
  subject     String
  status      String   @default("QUEUED")
  error       String?
  createdAt   DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────
// SUPPORT
// ─────────────────────────────────────────────────────────────────────────

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

model Ticket {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  status    TicketStatus    @default(OPEN)
  messages  TicketMessage[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model TicketMessage {
  id          String   @id @default(cuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  isFromAdmin Boolean  @default(false)
  message     String   @db.Text
  attachments String[]
  createdAt   DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────
// SETTINGS (site-wide, admin-editable, typed by key)
// ─────────────────────────────────────────────────────────────────────────

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// PERSONAL BRAND — Contact form submissions
// ─────────────────────────────────────────────────────────────────────────

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────
// ACADEMY — direct-to-course payment tracking (Course has no Product bridge,
// so this is a minimal, append-only order model dedicated to paid-course
// checkout; see src/app/api/academy/courses/[id]/enroll).
// ─────────────────────────────────────────────────────────────────────────

model CourseOrder {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  amount    Decimal  @db.Decimal(12, 0)
  status    String   @default("PENDING") // PENDING | PAID | FAILED
  authority String?
  refId     String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([courseId])
  @@index([authority])
}
