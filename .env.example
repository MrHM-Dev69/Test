DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/brandplatform?schema=public"

# Auth
AUTH_JWT_SECRET="REPLACE_WITH_RANDOM_32_BYTE_SECRET"
AUTH_SESSION_COOKIE_NAME="__session"
AUTH_ADMIN_2FA_ISSUER="BrandPlatform"

# App
APP_URL="http://localhost:3000"
NODE_ENV="development"
TIMEZONE="Asia/Tehran"

# Payments (provider-based, swap ACTIVE_PAYMENT_PROVIDER without touching core code)
ACTIVE_PAYMENT_PROVIDER="ZARINPAL"
ZARINPAL_MERCHANT_ID=""
ZARINPAL_SANDBOX="true"
IDPAY_API_KEY=""
IDPAY_SANDBOX="true"
NEXTPAY_API_KEY=""

# SMS (provider-based)
ACTIVE_SMS_PROVIDER="KAVENEGAR"
KAVENEGAR_API_KEY=""
KAVENEGAR_SENDER=""
SMSIR_API_KEY=""
SMSIR_LINE_NUMBER=""

# Email
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="no-reply@example.com"

# File storage (local disk by default; S3-compatible for production)
STORAGE_DRIVER="local"
STORAGE_LOCAL_PRIVATE_DIR="./storage/private"
STORAGE_LOCAL_PUBLIC_DIR="./public/uploads"
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION=""

# Signed download URLs
DOWNLOAD_SIGNING_SECRET="REPLACE_WITH_RANDOM_SECRET"
DOWNLOAD_URL_TTL_SECONDS="300"
